[Unit]
Description=Wake the computer and run Anskar Grotzschnapf once per day at noon

[Timer]
OnCalendar=*-*-* 12:00:00
Persistent=false
WakeSystem=true
AccuracySec=1min
Unit=anskar-daily.service
# Near-zero delay so the inhibited oneshot starts soon after RTC wake.
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
